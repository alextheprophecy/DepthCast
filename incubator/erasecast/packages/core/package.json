{
  "name": "erasecast",
  "version": "0.0.1",
  "description": "Client-side magic eraser — SAM2 select + LaMa inpaint, high-res tiled and seamless, 100% in the browser.",
  "keywords": ["inpainting","object-removal","magic-eraser","sam2","segment-anything","lama","webgpu","onnx","computer-vision","image-editing"],
  "license": "MIT",
  "author": "alextheprophecy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alextheprophecy/erasecast.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/alextheprophecy/erasecast",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "onnxruntime-web": "^1.20.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  },
  "publishConfig": { "access": "public" }
}
